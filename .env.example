# stocks_service configuration (copy to .env for local runs; Railway uses service variables)
# Must be a replica set (transactions). Local example:
#   mongod --replSet rs0 --port 27027 --dbpath ./mongo-data ; mongosh --port 27027 --eval 'rs.initiate()'
STOCKS_MONGO_URL=mongodb://127.0.0.1:27027/?directConnection=true
STOCKS_MONGO_DB=stocks
# Comma-separated; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STOCKS_API_KEYS=
